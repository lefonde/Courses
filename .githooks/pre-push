#!/bin/sh
set -eu

# Check the commit being sent to a publishing branch, not a cleaner working tree.
# This is a local safeguard. Branch-based GitHub Pages is not gated by CI alone.
repo_root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/gh-pages)
      case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
      esac
      printf '%s\n' 'Checking course-source review for the publishing commit...'
      node "$repo_root/scripts/check-publication.cjs" --revision "$local_oid" --remote-base "$remote_oid"
      ;;
  esac
done
